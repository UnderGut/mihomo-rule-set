# merge groups: group,type,url[,exclude_regex]
# type: list = plain domain list (MetaCubeX *.list) | yaml = blackmatrix7 classical (DOMAIN/DOMAIN-SUFFIX kept)
#       suffixlist = plain list, bare "x.com" becomes "+.x.com" (domain + subdomains)
#       locallist / localyaml = the same formats, file path inside this repo
# exclude_regex: optional ERE; matching domains are dropped (e.g. typosquats)
